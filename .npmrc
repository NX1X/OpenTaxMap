# Lifecycle scripts (postinstall and friends) are the usual delivery vehicle for
# a compromised npm package. CI already passes --ignore-scripts explicitly; this
# makes a plain local `npm install` behave the same way.
#
# Verified safe for this project: esbuild and rollup ship their native binaries
# as optionalDependencies, not via install scripts, so the build works without
# them.
ignore-scripts=true

# Fail loudly when a dependency declares a Node version this environment does
# not satisfy, instead of installing it and breaking at runtime. CI and the
# devcontainer pin Node 22 for this reason.
engine-strict=true
