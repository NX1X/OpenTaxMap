// Cloudflare Workers deployment (static assets).
// Deploy: npm run build && npx wrangler deploy
// The same dist/ output also works on Cloudflare Pages
// (build command: npm run build, output directory: dist).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentaxmap",
  "compatibility_date": "2026-07-01",
  "main": "src/worker.js",

  // Do NOT also expose this Worker at <name>.<account>.workers.dev. That URL
  // would run the same code while bypassing every zone-scoped control on
  // nx1xlab.dev (security-header rules, WAF, cache rules), including the
  // unauthenticated /cf/rum write path. Only the custom domain below is served.
  "workers_dev": false,

  // Per-IP rate limiter for the unauthenticated /cf/rum collector. Native to
  // Workers, so it does not consume a zone WAF rate-limiting rule. period must
  // be 10 or 60; namespace_id is any positive integer unique in the account.
  "ratelimits": [
    {
      "name": "RUM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Serve /yishuv/<slug> directly instead of 307-ing to /yishuv/<slug>/.
    // The prerendered pages' canonical tags and every sitemap entry use the
    // slash-less form, so the default auto-trailing-slash made all 536
    // advertised URLs redirect.
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "taxmap.nx1xlab.dev",
      "custom_domain": true
    }
  ],

  // Workers Logs only. This captures console output, exceptions, and
  // invocation metadata (viewable in the dashboard and via `wrangler tail`).
  // Traffic is low, so log every request (head_sampling_rate 1 = 100%); lower
  // it if volume grows. Distributed Traces are a separate feature and are NOT
  // enabled here - a single 3-route worker gets no benefit from them.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true }
  }
}
